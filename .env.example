# Vorlage für .env.local — Werte eintragen und NIEMALS committen.
#
# Supabase: Dashboard → Projekt öffnen → Settings (Zahnrad) → API Keys
# "Project URL" findest du unter Settings → General bzw. Settings → Data API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Ab Phase 7 (Erinnerungs-Job) — streng geheim, nur serverseitig. Der Job
# arbeitet ohne Login über alle Vermittler, deshalb der geheime Schlüssel:
# Supabase-Dashboard → Settings → API Keys → "Secret keys".
SUPABASE_SECRET_KEY=

# Ab Phase 7: Passwort, mit dem pg_cron den Job unter /api/erinnerungen
# aufruft. Beliebige lange Zufallszeichenfolge, z. B. erzeugt mit
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Derselbe Wert kommt in den Supabase Vault (siehe 0013_erinnerungen_cron.sql).
ERINNERUNG_GEHEIMNIS=

# Ab Phase 1: frei wählbares Wort, das man bei der Registrierung eingeben muss.
SIGNUP_INVITE_CODE=

# Ab Phase 5: Google-Kalender und Meet. Schritt für Schritt erklärt in der
# README unter "Google-Kalender einrichten". Fehlen die Werte, läuft alles
# andere unverändert — nur die Kalender-Synchronisation bleibt aus.
# Google Cloud Console → APIs & Dienste → Anmeldedaten → OAuth-Client-ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Verschlüsselt die gespeicherten Kalender-Zugänge in der Datenbank.
# 32 zufällige Bytes als Base64, hiermit erzeugt:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Achtung: Wird der Schlüssel später ausgetauscht, müssen alle Vermittler ihren
# Kalender neu verbinden.
KALENDER_TOKEN_SCHLUESSEL=

# Ab Phase 6: Google Gemini für die Mail-Personalisierung, gekapselt in
# src/lib/llm/. Google AI Studio → "Get API key". Vorerst die Gratis-Stufe
# (siehe CLAUDE.md) — vor echten Kundendaten Pflicht-Wechsel auf eine bezahlte
# Stufe. Genutzt nur für „Hinweis mit KI einarbeiten" auf der Terminseite;
# fehlt der Key, gibt es diesen Knopf nicht — alles andere läuft unverändert.
GEMINI_API_KEY=

# Optional: überschreibt das Standard-Modell in src/lib/llm/gemini/anfragen.ts,
# falls Google ein Modell umbenennt oder abkündigt. Ohne diese Variable gilt
# der Code-Default.
# GEMINI_MODEL=gemini-3.8-flash

# Ab Phase 6: Mailversand über Resend, gekapselt in src/lib/email/.
# resend.com → API Keys. Fehlt der Key, bleibt der Mailversand aus (Termine,
# Kalender, alles andere funktioniert unverändert).
RESEND_API_KEY=

# Die gemeinsame Absender-Adresse für alle Vermittler (siehe CLAUDE.md — kein
# eigener Absender je Person, dafür Anzeigename + Reply-To). Für den ersten
# Test reicht Resends eigene Testadresse "onboarding@resend.dev" — damit lässt
# sich aber nur an die eigene, bei Resend verifizierte Kontoadresse senden. Für
# echte Kunden-Adressen ist vor dem Go-Live eine eigene verifizierte Domain in
# Resend nötig.
EMAIL_ABSENDER_ADRESSE=onboarding@resend.dev
